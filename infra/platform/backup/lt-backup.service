[Unit]
Description=LiveTranslator platform backup (PostgreSQL + RustFS + config -> restic)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PLATFORM@
ExecStart=/usr/bin/bash @PLATFORM@/backup/backup.sh
# be gentle with the rest of the machine
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
