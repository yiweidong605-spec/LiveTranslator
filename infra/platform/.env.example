# The keys that live in ~/platform/.env on the mini PC. Never commit the real file.
# gen-env.sh writes the first block with random values; the others are added by the scripts named.

# --- gen-env.sh ---
POSTGRES_PASSWORD=
MLFLOW_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MLFLOW_ALLOWED_HOSTS=localhost,localhost:*,swt17,swt17:*,*.ts.net,*.ts.net:*,100.*
MLFLOW_CORS_ORIGINS=http://localhost:5000,http://swt17:5000,http://*.ts.net:5000
BUCKETS=mlflow,lt-logs,lt-datasets,lt-models
AIRFLOW_UID=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# --- provision-sync.sh (desktop sync.bat accounts) ---
LT_SYNC_S3_SECRET=
LT_SYNC_AIRFLOW_PASSWORD=

# --- backup/install-backup.sh (keep a copy in your password manager!) ---
RESTIC_PASSWORD=
